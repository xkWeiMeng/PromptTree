{
  "name": "prompttree",
  "version": "0.1.0",
  "private": true,
  "description": "Prompt 管理工具 - 让混乱归于秩序",
  "scripts": {
    "dev:web": "pnpm --filter @prompttree/web dev",
    "dev:backend": "pnpm --filter @prompttree/backend dev",
    "dev:extension": "pnpm --filter @prompttree/extension dev",
    "dev:mobile": "pnpm --filter @prompttree/mobile start",
    "build:web": "pnpm --filter @prompttree/web build",
    "build:backend": "pnpm --filter @prompttree/backend build",
    "build:extension": "pnpm --filter @prompttree/extension build",
    "build:all": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "keywords": ["prompt", "chatgpt", "ai", "productivity"],
  "author": "",
  "license": "MIT"
}
