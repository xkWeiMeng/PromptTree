# 服务器配置
PORT=3000
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# JWT 密钥（生产环境请使用强密钥）
JWT_SECRET=your-super-secret-key-at-least-32-chars
API_KEY_SECRET=your-api-key-secret-at-least-32-chars

# Google OAuth（推荐）
# 在 https://console.cloud.google.com/apis/credentials 创建 OAuth 2.0 客户端 ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# GitHub OAuth（可选）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 移动端 Deep Link Scheme（GitHub OAuth 回调到 App）
MOBILE_DEEP_LINK_SCHEME=prompttree

# 邮件配置（魔法链接，可选）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 数据库路径
DB_PATH=../../data/prompttree.db

# 管理后台密钥（仅限本机访问，生产环境请使用强密钥）
ADMIN_SECRET=your-admin-secret-change-in-production
