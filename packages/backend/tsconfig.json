{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@prompttree/shared": ["../shared/src"],
      "@prompttree/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src"]
}
