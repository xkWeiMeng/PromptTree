{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ESNext", "DOM"],
    "paths": {
      "@/*": ["./"],
      "@prompttree/shared": ["../shared/src"],
      "@prompttree/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.vue"]
}
